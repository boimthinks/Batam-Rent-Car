---
import { ChevronDown, HelpCircle } from '@lucide/astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  title?: string;
  lang?: 'id' | 'en';
}

const {
  items,
  title = "Pertanyaan Umum Seputar Rental Mobil di Batam",
  lang = 'id'
} = Astro.props;

// Generate FAQPage JSON-LD
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section class="my-8">
  <!-- Section Title -->
  <div class="flex items-center gap-2 mb-4">
    <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center">
      <HelpCircle class="w-4 h-4" />
    </div>
    <div>
      <h2 class="text-base sm:text-lg font-black text-slate-900 leading-tight">{title}</h2>
      <p class="text-xs text-slate-500">Jawaban cepat seputar syarat sewa, titik jemput, & pembayaran</p>
    </div>
  </div>

  <!-- Accordion List -->
  <div class="space-y-2.5">
    {items.map((item, idx) => (
      <details class="faq-item group bg-white rounded-2xl border border-slate-200/90 shadow-xs overflow-hidden transition-all duration-200 open:border-blue-300 open:shadow-sm">
        <summary class="flex items-center justify-between p-4 cursor-pointer font-bold text-slate-800 text-xs sm:text-sm select-none group-hover:text-blue-600 transition-colors list-none">
          <span class="flex-1 pr-3">{item.question}</span>
          <ChevronDown class="w-4 h-4 text-slate-400 group-open:rotate-180 group-hover:text-blue-600 transition-transform duration-200 shrink-0" />
        </summary>
        <div class="px-4 pb-4 pt-1 text-xs text-slate-600 leading-relaxed border-t border-slate-100 mt-1">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>

  <!-- Embed FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
