---
interface Props {
  variant?: 'blog' | 'footer';
  lang?: 'id' | 'en';
}

const { variant = 'blog', lang = 'id' } = Astro.props;
const domain = 'https://lincahrentcar.com';
const googlePrefUrl = `https://www.google.com/preferences/source?q=${encodeURIComponent(domain)}`;
---

{variant === 'blog' ? (
  <div class="my-6 p-5 sm:p-6 bg-gradient-to-br from-blue-50/80 via-white to-slate-50 border border-blue-200/80 rounded-3xl shadow-xs">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-start gap-3.5">
        <!-- Google G multi-color icon -->
        <div class="w-10 h-10 rounded-2xl bg-white shadow-xs border border-slate-200/80 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-extrabold text-slate-900 leading-snug">
            {lang === 'en'
              ? 'Add Lincah Rent Car to Your Google Favorite Sources'
              : 'Rekomendasikan Lincah Rent Car di Google'}
          </h4>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">
            {lang === 'en'
              ? 'Get instant Batam travel guides and reliable car rental updates directly in your Google Search and News feed.'
              : 'Dapatkan panduan rute Batam, info tarif armada, dan tips perjalanan terbaru langsung di Google Search & Google News Anda.'}
          </p>
        </div>
      </div>

      <button
        type="button"
        class="add-preferred-source-btn shrink-0 w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-bold text-xs shadow-xs hover:shadow-md transition-all cursor-pointer"
        data-domain={domain}
        aria-label={lang === 'en' ? 'Add as favorite source in Google' : 'Tambah sebagai sumber favorit di Google'}
      >
        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <span>{lang === 'en' ? 'Follow on Google' : 'Ikuti di Google'}</span>
      </button>
    </div>
  </div>
) : (
  <div class="mt-4 pt-4 border-t border-slate-800">
    <button
      type="button"
      class="add-preferred-source-btn inline-flex items-center gap-2.5 px-3.5 py-2 rounded-xl bg-slate-800/90 hover:bg-slate-700/90 text-slate-200 hover:text-white border border-slate-700/80 text-xs font-semibold shadow-xs transition-all cursor-pointer w-full sm:w-auto justify-center"
      data-domain={domain}
      aria-label={lang === 'en' ? 'Add Lincah Rent Car to Google Favorite Sources' : 'Jadikan Lincah Rent Car sumber favorit di Google'}
    >
      <!-- Google G icon -->
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
      </svg>
      <span>
        {lang === 'en'
          ? 'Add to Google Favorite Sources'
          : 'Jadikan Sumber Referensi di Google'}
      </span>
    </button>
  </div>
)}

<script is:inline>
  function setupGoogleSourcePreferences() {
    document.querySelectorAll('.add-preferred-source-btn').forEach((btn) => {
      // Prevent attaching duplicate listeners
      if (btn.getAttribute('data-listener-attached') === 'true') return;
      btn.setAttribute('data-listener-attached', 'true');

      btn.addEventListener('click', () => {
        const domain = btn.getAttribute('data-domain') || 'https://lincahrentcar.com';
        const targetUrl = 'https://www.google.com/preferences/source?q=' + encodeURIComponent(domain);

        try {
          if (window.google && window.google.news && window.google.news.sourcePreferences) {
            window.google.news.sourcePreferences.showDialog({
              forceReload: true,
              sourceUrl: domain,
            });
          } else {
            window.open(targetUrl, '_blank', 'noopener,noreferrer');
          }
        } catch (e) {
          window.open(targetUrl, '_blank', 'noopener,noreferrer');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupGoogleSourcePreferences);
  document.addEventListener('astro:page-load', setupGoogleSourcePreferences);
</script>
