---
import { MapPin, ArrowRight } from '@lucide/astro';
import { getCollection } from 'astro:content';

interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;
const isEn = lang === 'en';

const selectedSlugs = [
  'batam-centre',
  'harbour-bay',
  'hang-nadim',
  'sekupang',
  'mega-legenda',
];

const allLocations = await getCollection('lokasi');
const locationMap = new Map(
  allLocations.map((loc) => [loc.id.replace(/\.md$/, ''), loc])
);

const hubs = selectedSlugs
  .map((slug) => {
    const loc = locationMap.get(slug);
    if (!loc) return null;
    return {
      slug,
      name: loc.data.areaName,
      type: loc.data.hubType,
      badge: loc.data.pickupTimeEstimate,
      image: loc.data.image,
    };
  })
  .filter(Boolean);
---

<div class="my-6">
  <div class="flex items-center justify-between mb-3">
    <div>
      <h2 class="text-xs sm:text-sm font-black uppercase tracking-wider text-slate-900 flex items-center gap-1.5">
        <MapPin class="w-4 h-4 text-blue-600" />
        <span>{isEn ? 'Pickup Points in Batam' : 'Titik Jemput Batam'}</span>
      </h2>
      <p class="text-[11px] text-slate-500">{isEn ? 'Select your arrival point for fast handover' : 'Mobil diantar langsung ke lobi kedatangan Anda'}</p>
    </div>
    <a href={isEn ? "/en/lokasi" : "/lokasi"} class="text-[11px] font-bold text-blue-600 hover:text-blue-700 flex items-center gap-0.5">
      <span>{isEn ? 'View All' : 'Semua Lokasi'}</span>
      <ArrowRight class="w-3 h-3" />
    </a>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2.5">
    {hubs.map((hub) => (
      <a
        href={isEn ? `/en/lokasi/${hub.slug}` : `/lokasi/${hub.slug}`}
        class="bg-white rounded-2xl border border-slate-200/90 shadow-xs hover:border-blue-500 hover:shadow-sm transition-all group flex flex-col justify-between overflow-hidden"
      >
        <div class="relative aspect-[4/3] w-full bg-slate-100 overflow-hidden">
          <img
            src={hub.image}
            alt={hub.name}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
          <span class="absolute top-1.5 right-1.5 px-1.5 py-0.5 rounded bg-emerald-500 text-white text-[9px] font-bold shadow-xs">
            {hub.badge}
          </span>
        </div>
        <div class="p-2.5">
          <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5 group-hover:text-blue-600">{hub.type}</span>
          <span class="font-bold text-xs text-slate-900 group-hover:text-blue-600 line-clamp-1">
            {hub.name}
          </span>
        </div>
      </a>
    ))}
  </div>
</div>
