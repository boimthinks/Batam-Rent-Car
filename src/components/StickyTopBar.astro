---
import { MapPin, Globe } from '@lucide/astro';
import { getAlternateUrl } from '../utils/i18n';

interface Props {
  lang?: 'id' | 'en';
  currentPath?: string;
}

const { lang = 'id', currentPath = '/' } = Astro.props;

const idSwitchUrl = getAlternateUrl(currentPath, 'id');
const enSwitchUrl = getAlternateUrl(currentPath, 'en');

const navLinks = lang === 'en' ? [
  { href: '/en', label: 'Home' },
  { href: '/en/car', label: 'Cars' },
  { href: '/en/layanan', label: 'Services' },
  { href: '/en/lokasi', label: 'Pickup Hubs' },
  { href: '/en/guide', label: 'Travel Guide' },
] : [
  { href: '/', label: 'Beranda' },
  { href: '/mobil', label: 'Mobil' },
  { href: '/layanan', label: 'Layanan' },
  { href: '/lokasi', label: 'Titik Jemput' },
  { href: '/blog', label: 'Blog' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-2">
    <!-- Brand / Logo -->
    <a href={lang === 'en' ? '/en' : '/'} class="flex items-center gap-2 group shrink-0">
      <div class="w-9 h-9 rounded-xl bg-blue-600 flex items-center justify-center text-white font-black text-lg shadow-sm group-hover:scale-105 transition-transform">
        L
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-base tracking-tight text-slate-900 leading-none">
          LINCAH<span class="text-blue-600 font-black">RENT</span>
        </span>
        <span class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Batam Car Rental</span>
      </div>
    </a>

    <!-- Location Pin Badge (Batam) -->
    <div class="hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold border border-slate-200">
      <MapPin class="w-3.5 h-3.5 text-blue-600 shrink-0" />
      <span>Batam</span>
    </div>

    <!-- Desktop Navigation Menu -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && link.href !== '/en' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class:list={[
              "transition-colors hover:text-blue-600 py-1 border-b-2",
              isActive ? "text-blue-600 font-bold border-blue-600" : "border-transparent text-slate-600"
            ]}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Language Pill Switcher & CTA -->
    <div class="flex items-center gap-2 shrink-0">
      <div class="flex items-center bg-slate-100 p-1 rounded-full border border-slate-200 text-xs font-bold">
        <a
          href={idSwitchUrl}
          class:list={[
            "px-2.5 py-1 rounded-full transition-all text-[11px]",
            lang === 'id' ? "bg-white text-blue-700 shadow-xs font-black" : "text-slate-500 hover:text-slate-800"
          ]}
          aria-label="Bahasa Indonesia"
        >
          ID
        </a>
        <a
          href={enSwitchUrl}
          class:list={[
            "px-2.5 py-1 rounded-full transition-all text-[11px]",
            lang === 'en' ? "bg-white text-blue-700 shadow-xs font-black" : "text-slate-500 hover:text-slate-800"
          ]}
          aria-label="English Version"
        >
          EN
        </a>
      </div>

      <!-- Quick WA Button on Top for Desktop -->
      <a
        href="https://wa.me/6281373703639?text=Halo%20Admin%20Lincah%20Rent%20Car,%20saya%20ingin%20tanya%20sewa%20mobil%20di%20Batam"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-colors shadow-xs"
      >
        <span>WA 24/7</span>
      </a>
    </div>
  </div>
</header>
