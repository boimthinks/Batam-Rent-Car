---
import AppLayout from '../../layouts/AppLayout.astro';
import AutoLinkContent from '../../components/AutoLinkContent.astro';
import GoogleSourcePreferences from '../../components/GoogleSourcePreferences.astro';
import { getCollection, render } from 'astro:content';
import { Calendar, User, ArrowLeft, MessageCircle, List, Phone, ShieldCheck, Clock, CheckCircle2, ArrowRight } from '@lucide/astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'id');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const articleCity = d.city || 'Batam';
const isPalembang = articleCity.toLowerCase() === 'palembang';

// Related Articles: same lang ('id') and same city, excluding current post, sorted latest first
const allCityPosts = await getCollection('blog', ({ data, id }) => {
  const pCity = data.city || 'Batam';
  return data.lang === 'id' && pCity.toLowerCase() === articleCity.toLowerCase() && id !== post.id;
});
const relatedPosts = allCityPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 6);

// Filter headings untuk Table of Contents (h2 dan h3)
const tocHeadings = (headings || []).filter((h) => h.depth === 2 || h.depth === 3);

// WhatsApp URL
const waText = `Halo Admin Lincah Rent Car, saya baru saja membaca artikel "${d.title}" dan ingin tanya info sewa mobil di ${articleCity}.`;
const waUrl = `https://wa.me/6281373703639?text=${encodeURIComponent(waText)}`;

// Article Schema.org
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": d.title,
  "description": d.summary,
  "image": `https://lincahrentcar.com${d.featuredImage}`,
  "datePublished": d.pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": d.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Lincah Rent Car",
    "logo": {
      "@type": "ImageObject",
      "url": "https://lincahrentcar.com/logo.svg"
    }
  }
};
---

<AppLayout
  title={d.title}
  description={d.summary}
  ogImage={`https://lincahrentcar.com${d.featuredImage}`}
  alternateUrl={d.alternateSlug ? `/en/guide/${d.alternateSlug}/` : undefined}
  schema={articleSchema}
>
  <!-- Back Button & Breadcrumbs -->
  <div class="mb-4">
    <a href="/blog/" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-blue-600">
      <ArrowLeft class="w-4 h-4" />
      <span>Kembali ke Blog & Panduan</span>
    </a>
  </div>

  <!-- 2-Column Grid Layout matching Armada, Layanan & Lokasi -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left Col: Main Article Content (2 cols) -->
    <article class="lg:col-span-2 space-y-6 min-w-0">
      <!-- Article Header Card -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-xs space-y-4">
        <div class="flex items-center gap-4 text-xs font-bold text-slate-400">
          <span class="flex items-center gap-1.5">
            <Calendar class="w-3.5 h-3.5 text-blue-600" />
            <span>{d.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </span>
          <span class="flex items-center gap-1.5">
            <User class="w-3.5 h-3.5 text-blue-600" />
            <span>{d.author}</span>
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 leading-tight tracking-tight">
          {d.title}
        </h1>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed italic border-l-4 border-blue-600 pl-3">
          {d.summary}
        </p>
      </div>

      <!-- Featured Image (4:3) -->
      <div class="relative aspect-[4/3] rounded-3xl overflow-hidden bg-slate-100 border border-slate-200/90 shadow-sm">
        <img
          src={d.featuredImage}
          alt={d.title}
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Article Body -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-xs blog-content">
        <AutoLinkContent lang="id">
          <Content />
        </AutoLinkContent>
      </div>

      <!-- Auto wrap any markdown table with responsive scroll container -->
      <script is:inline>
        function wrapBlogTables() {
          const content = document.querySelector('.blog-content');
          if (!content) return;
          const tables = content.querySelectorAll('table');
          tables.forEach((table) => {
            if (table.parentElement.classList.contains('table-wrapper')) return;
            const wrapper = document.createElement('div');
            wrapper.className = 'table-wrapper';
            table.parentNode.insertBefore(wrapper, table);
            wrapper.appendChild(table);
          });
        }
        document.addEventListener('DOMContentLoaded', wrapBlogTables);
        document.addEventListener('astro:page-load', wrapBlogTables);
      </script>

      <!-- Google Source Recommendation Box -->
      <GoogleSourcePreferences variant="blog" lang="id" />

      <!-- Bottom In-Article WhatsApp Banner -->
      <div class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white rounded-3xl p-6 sm:p-8 shadow-md flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-base sm:text-lg font-black mb-1">
            Rencanakan Perjalanan Anda di {articleCity}
          </h3>
          <p class="text-xs text-blue-100">
            {isPalembang
              ? "Dapatkan armada bersih dengan penjemputan langsung di Bandara SMB II, Stasiun Kertapati, atau hotel."
              : "Dapatkan armada bersih dengan penjemputan gratis di pelabuhan atau bandara."}
          </p>
        </div>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white text-xs sm:text-sm font-black shadow-md transition-all active:scale-95"
        >
          <MessageCircle class="w-4 h-4 fill-current" />
          <span>Chat CS WhatsApp</span>
        </a>
      </div>

      <!-- Related Articles Section (Filtered by Lang & City) -->
      {relatedPosts.length > 0 && (
        <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-xs space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div>
              <h3 class="text-base sm:text-lg font-black text-slate-900 tracking-tight">
                Panduan Terkait di {articleCity}
              </h3>
              <p class="text-xs text-slate-500">
                Rekomendasi artikel seputar rute, tarif, dan tips rental mobil di {articleCity}
              </p>
            </div>
            <a
              href="/blog/"
              class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1 shrink-0"
            >
              <span>Semua Blog</span>
              <ArrowRight class="w-3.5 h-3.5" />
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {relatedPosts.map((rPost) => {
              const rSlug = rPost.id.replace(/\.md$/, '');
              const rData = rPost.data;
              return (
                <article class="bg-slate-50/70 hover:bg-slate-50 rounded-2xl border border-slate-200/70 overflow-hidden flex flex-col justify-between group transition-all">
                  <div>
                    <a href={`/blog/${rSlug}/`} class="aspect-[16/10] w-full overflow-hidden bg-slate-100 block">
                      <img
                        src={rData.featuredImage}
                        alt={rData.title}
                        loading="lazy"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      />
                    </a>
                    <div class="p-3.5">
                      <div class="flex items-center gap-1.5 text-[10px] font-bold text-slate-400 mb-1.5">
                        <Calendar class="w-3 h-3 text-blue-600" />
                        <span>{rData.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                      </div>
                      <h4 class="text-xs font-extrabold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 leading-snug">
                        <a href={`/blog/${rSlug}/`}>{rData.title}</a>
                      </h4>
                    </div>
                  </div>
                  <div class="p-3.5 pt-0">
                    <a
                      href={`/blog/${rSlug}/`}
                      class="pt-2 border-t border-slate-200/60 flex items-center justify-between text-[11px] font-bold text-blue-600 group-hover:text-blue-700"
                    >
                      <span>Baca Panduan</span>
                      <ArrowRight class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )}
    </article>

    <!-- Right Col: Sticky Sidebar with TOC & WhatsApp CTA -->
    <aside class="lg:col-span-1 space-y-4">
      <div class="space-y-4 sticky top-20">
        <!-- Sidebar Widget 1: Table of Contents (TOC) -->
        {tocHeadings.length > 0 && (
          <div class="bg-white rounded-3xl p-5 border border-slate-200/90 shadow-sm">
            <div class="flex items-center gap-2 mb-3 pb-3 border-b border-slate-100">
              <div class="w-7 h-7 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center">
                <List class="w-4 h-4" />
              </div>
              <div>
                <h3 class="text-xs font-black uppercase tracking-wider text-slate-900">Daftar Isi Artikel</h3>
                <span class="text-[10px] text-slate-400">Navigasi cepat topik</span>
              </div>
            </div>

            <nav class="space-y-1.5" aria-label="Table of Contents">
              {tocHeadings.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class:list={[
                    "block text-xs text-slate-600 hover:text-blue-600 hover:translate-x-0.5 transition-all py-1 leading-snug rounded-lg px-2 hover:bg-blue-50/60",
                    heading.depth === 3 ? "pl-5 text-slate-500 font-medium" : "font-bold text-slate-800"
                  ]}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </div>
        )}

        <!-- Sidebar Widget 2: CTA WhatsApp (Sticky) -->
        <div class="bg-white rounded-3xl p-5 border border-slate-200/90 shadow-sm">
          <span class="text-xs font-bold text-blue-600 uppercase tracking-wider block mb-1">
            Butuh Rental Mobil?
          </span>
          <h3 class="text-base font-black text-slate-900 mb-2">
            Konsultasi Rute & Unit {articleCity}
          </h3>
          <p class="text-xs text-slate-500 mb-4 leading-relaxed">
            {isPalembang
              ? "Admin operasional kami siap membantu memilih armada tepat untuk perjalanan di Palembang, cek jadwal kedatangan Bandara SMB II / Stasiun Kertapati, dan serah terima unit tepat waktu."
              : "Admin operasional kami siap membantu memilih armada tepat untuk rute Anda, cek jadwal kapal/pesawat, dan serah terima unit gratis di pelabuhan."}
          </p>

          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-xs sm:text-sm shadow-md transition-all active:scale-95"
          >
            <MessageCircle class="w-4 h-4 fill-current" />
            <span>Chat CS via WhatsApp</span>
          </a>

          <div class="mt-4 pt-4 border-t border-slate-100 space-y-2 text-xs text-slate-500">
            <div class="flex items-center gap-2">
              <Phone class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
              <span class="font-semibold text-slate-700">0813-7370-3639 (24 Jam)</span>
            </div>
            <div class="flex items-start gap-2">
              <ShieldCheck class="w-3.5 h-3.5 text-blue-600 shrink-0 mt-0.5" />
              <span>Unit bersih disinfektan, terawat prima, lepas kunci & supir.</span>
            </div>
            <div class="flex items-start gap-2">
              <Clock class="w-3.5 h-3.5 text-amber-600 shrink-0 mt-0.5" />
              <span>
                {isPalembang
                  ? "Antar unit Bandara SMB II, Stasiun Kertapati & TAA."
                  : "Free delivery lobi Harbour Bay, Batam Centre & Bandara."}
              </span>
            </div>
          </div>
        </div>
      </div>
    </aside>
  </div>
</AppLayout>
