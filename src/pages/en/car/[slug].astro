---
import AppLayout from '../../../layouts/AppLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatIDR, estimateSGD, estimateMYR } from '../../../utils/currency';
import { buildWhatsAppUrl } from '../../../utils/whatsapp';
import { renderMarkdownToString } from '../../../utils/renderMarkdown';
import AutoLinkContent from '../../../components/AutoLinkContent.astro';
import { Users, Briefcase, Cog, CheckCircle2, ShieldCheck, MapPin, MessageCircle, ArrowLeft, ArrowRight, Clock } from '@lucide/astro';

export async function getStaticPaths() {
  const cars = await getCollection('mobil');
  return cars.map((car) => ({
    params: { slug: car.id.replace(/\.md$/, '') },
    props: { car },
  }));
}

const { car } = Astro.props;
const { Content } = await render(car);
const slug = car.id.replace(/\.md$/, '');
const d = car.data;

const allLocations = await getCollection('lokasi');

const hasSelfDrive = Boolean(d.priceDailySelfDrive);
const minPrice = d.priceDailySelfDrive || d.priceDailyWithDriver;

// English content (falls back to Indonesian when EN field is empty)
const popularForEn = d.popularForEn || d.popularFor;
const featuresEn = d.featuresEn || d.features;
const categoryEn = d.categoryEn || d.category;
const bodyEnHtml = d.bodyEn ? await renderMarkdownToString(d.bodyEn) : '';

const waUrl = buildWhatsAppUrl({
  carModel: d.carModel,
  lang: 'en',
});

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `${d.carModel} Rental in Batam`,
  "image": `https://lincahrentcar.com${d.image}`,
  "description": `Book ${d.carModel} in Batam. Capacity ${d.seats} seats, ${d.luggageCapacity} suitcases. Free pickup at Harbour Bay & Batam Centre ferry terminals.`,
  "brand": {
    "@type": "Brand",
    "name": "Lincah Rent Car"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "IDR",
    "price": minPrice,
    "availability": "https://schema.org/InStock",
    "url": `https://lincahrentcar.com/en/car/${slug}/`,
    "seller": {
      "@type": "AutoRental",
      "name": "Lincah Rent Car"
    }
  }
};
---

<AppLayout
  title={`Rent ${d.carModel} in Batam - Rates & Ferry Pickup`}
  description={`Rent ${d.carModel} in Batam from ${estimateSGD(minPrice)}/day (${formatIDR(minPrice)}). Free handover at Harbour Bay & Batam Centre. Self-drive & chauffeur.`}
  ogImage={`https://lincahrentcar.com${d.image}`}
  lang="en"
  schema={productSchema}
>
  <div class="mb-3 flex items-center justify-between">
    <a href="/en/car/" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-blue-600">
      <ArrowLeft class="w-4 h-4" />
      <span>Back to All Cars</span>
    </a>
    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">{d.category}</span>
  </div>

  <!-- Main H1 Heading for SEO -->
  <div class="mb-5">
    <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
      Rent {d.carModel} in Batam
    </h1>
    <p class="text-xs sm:text-sm text-slate-500 mt-1">
      {popularForEn} • 24-hour self-drive & chauffeur service
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="relative aspect-[4/3] rounded-3xl overflow-hidden bg-slate-100 border border-slate-200/90 shadow-sm">
        <img
          src={d.image}
          alt={d.carModel}
          class="w-full h-full object-cover"
        />
        <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-white/90 backdrop-blur-md text-slate-800 text-xs font-bold shadow-xs">
          {d.category}
        </span>
      </div>

      <div class="grid grid-cols-3 gap-3 bg-white p-4 rounded-2xl border border-slate-200/90 shadow-xs">
        <div class="flex flex-col items-center text-center">
          <Users class="w-5 h-5 text-blue-600 mb-1" />
          <span class="text-[11px] text-slate-400 font-medium">Capacity</span>
          <span class="text-xs sm:text-sm font-extrabold text-slate-800">{d.seats} Passengers</span>
        </div>
        <div class="flex flex-col items-center text-center border-x border-slate-100">
          <Briefcase class="w-5 h-5 text-blue-600 mb-1" />
          <span class="text-[11px] text-slate-400 font-medium">Luggage</span>
          <span class="text-xs sm:text-sm font-extrabold text-slate-800">{d.luggageCapacity} Suitcases</span>
        </div>
        <div class="flex flex-col items-center text-center">
          <Cog class="w-5 h-5 text-blue-600 mb-1" />
          <span class="text-[11px] text-slate-400 font-medium">Transmission</span>
          <span class="text-xs sm:text-sm font-extrabold text-slate-800">{d.transmission}</span>
        </div>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200/90 shadow-xs">
        <h2 class="text-lg font-black text-slate-900 mb-4">Vehicle Overview & Specifications</h2>
        <div class="prose prose-slate max-w-none text-xs sm:text-sm leading-relaxed text-slate-600">
          {bodyEnHtml ? <AutoLinkContent lang="en" html={bodyEnHtml} /> : <Content />}
        </div>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200/90 shadow-xs">
        <h3 class="text-base font-black text-slate-900 mb-3">Vehicle Features & Comfort</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {featuresEn.map((ft) => (
            <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-700">
              <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0" />
              <span>{ft}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Cardview Titik Jemput Mobil (EN) -->
      <div class="space-y-4 pt-4">
        <div class="flex items-center justify-between">
          <div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-[11px] font-bold mb-1">
              <MapPin class="w-3.5 h-3.5 text-blue-600" />
              <span>Complimentary Delivery</span>
            </span>
            <h2 class="text-lg font-black text-slate-900"><span class="city-name-dyn">Batam</span> Pickup Hubs</h2>
          </div>
          <a href="/en/lokasi/" class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1">
            <span>All Pickup Hubs</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {allLocations.map((loc) => {
            const locSlug = loc.id.replace(/\.md$/, '');
            const locData = loc.data;
            const locCity = locData.city || 'Batam';
            const isDefaultBatam = locCity.toLowerCase() === 'batam';
            const locHubType = locData.hubTypeEn || locData.hubType;
            const locPickupTime = locData.pickupTimeEstimateEn || locData.pickupTimeEstimate;
            const locAreaName = locData.areaNameEn || locData.areaName;
            const locDesc = locData.descriptionEn || locData.description;
            return (
              <div
                class:list={[
                  "pickup-hub-card bg-white rounded-2xl border border-slate-200/90 shadow-xs hover:border-blue-500 hover:shadow-md transition-all overflow-hidden flex flex-col justify-between group",
                  !isDefaultBatam && "hidden"
                ]}
                data-city={locCity}
              >
                <div>
                  <a href={`/en/lokasi/${locSlug}/`} class="relative aspect-[4/3] w-full bg-slate-100 overflow-hidden block">
                    <img
                      src={locData.image}
                      alt={locData.title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                    <span class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-white/90 backdrop-blur-xs text-slate-800 text-[10px] font-bold shadow-xs">
                      {locHubType}
                    </span>
                    <span class="absolute top-2 right-2 px-2 py-0.5 rounded-md bg-emerald-500 text-white text-[10px] font-bold shadow-xs flex items-center gap-1">
                      <Clock class="w-2.5 h-2.5" />
                      <span>{locPickupTime}</span>
                    </span>
                  </a>

                  <div class="p-3.5">
                    <h3 class="text-xs font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-1 line-clamp-1">
                      <a href={`/en/lokasi/${locSlug}/`}>{locAreaName}</a>
                    </h3>
                    <p class="text-[11px] text-slate-500 line-clamp-2 leading-relaxed">
                      {locDesc}
                    </p>
                  </div>
                </div>

                <div class="p-3.5 pt-0">
                  <a
                    href={`/en/lokasi/${locSlug}/`}
                    class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-[11px] font-bold text-blue-600 group-hover:text-blue-700"
                  >
                    <span>Handover Details</span>
                    <ArrowRight class="w-3 h-3 group-hover:translate-x-1 transition-transform" />
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <!-- Right Col: Booking Card -->
    <div class="lg:col-span-1 space-y-4">
      <div class="bg-white rounded-3xl p-5 border border-slate-200/90 shadow-sm sticky top-20">
        <span class="text-xs font-bold text-blue-600 uppercase tracking-wider block mb-1">
          Daily Rental Rate
        </span>
        <span class="text-xl sm:text-2xl font-black text-slate-900 mb-4 block">
          {d.carModel}
        </span>

        <div class="space-y-3 mb-5">
          {hasSelfDrive && (
            <div class="p-3.5 rounded-2xl bg-blue-50/70 border border-blue-200">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-blue-900">Self-Drive (24 Hours)</span>
                <span class="text-xs font-bold text-blue-600">{estimateSGD(d.priceDailySelfDrive!)}</span>
              </div>
              <div class="mt-1 flex items-baseline gap-1">
                <span class="text-xl font-black text-blue-700">{formatIDR(d.priceDailySelfDrive!)}</span>
                <span class="text-xs text-slate-500">/day</span>
              </div>
              <span class="text-[10px] text-slate-500 block mt-1">Valid Singapore / Malaysia driving licence required</span>
            </div>
          )}

          <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-900">With Chauffeur (12 Hours)</span>
              <span class="text-xs font-bold text-slate-600">{estimateSGD(d.priceDailyWithDriver)}</span>
            </div>
            <div class="mt-1 flex items-baseline gap-1">
              <span class="text-xl font-black text-slate-900">{formatIDR(d.priceDailyWithDriver)}</span>
              <span class="text-xs text-slate-500">/day</span>
            </div>
            <span class="text-[10px] text-slate-500 block mt-1">Includes friendly local professional driver</span>
          </div>
        </div>

        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-sm shadow-md transition-all active:scale-95"
        >
          <MessageCircle class="w-5 h-5 fill-current" />
          <span>Book via WhatsApp</span>
        </a>

        <div class="mt-4 p-3 rounded-xl bg-amber-50 border border-amber-200/80 text-[11px] text-amber-900 flex items-start gap-1.5">
          <ShieldCheck class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" />
          <span>Vehicle is fully cleaned, sanitised, and inspected before handover.</span>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function syncEnCarDetailCity(city) {
      const isPalembang = city === 'palembang';

      // Update H2 .city-name-dyn (... Pickup Hubs)
      document.querySelectorAll('.city-name-dyn').forEach((el) => {
        el.textContent = isPalembang ? 'Palembang' : 'Batam';
      });

      // Filter pickup hub cards by city
      const cards = document.querySelectorAll('.pickup-hub-card');
      cards.forEach((card) => {
        const cardCity = (card.getAttribute('data-city') || 'Batam').toLowerCase();
        if (cardCity === city.toLowerCase()) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    function initEnCarDetailCitySync() {
      try {
        const savedCity = localStorage.getItem('lincah_city') || 'batam';
        syncEnCarDetailCity(savedCity);
      } catch (e) {}
    }

    window.addEventListener('cityChange', (e) => {
      if (e.detail && e.detail.city) {
        syncEnCarDetailCity(e.detail.city);
      }
    });

    document.addEventListener('DOMContentLoaded', initEnCarDetailCitySync);
    document.addEventListener('astro:page-load', initEnCarDetailCitySync);
  </script>
</AppLayout>
