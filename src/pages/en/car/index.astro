---
import AppLayout from '../../../layouts/AppLayout.astro';
import VehicleCard from '../../../components/VehicleCard.astro';
import HorizontalFilterChips from '../../../components/HorizontalFilterChips.astro';
import BottomSheetModal from '../../../components/BottomSheetModal.astro';
import PickupHubChips from '../../../components/PickupHubChips.astro';
import { getCollection } from 'astro:content';
import { Car, ShieldCheck } from '@lucide/astro';

const cars = await getCollection('mobil');
const sortedCars = [...cars].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return 0;
});

const sheetCars = sortedCars.map((c) => ({
  id: c.id,
  slug: c.id.replace(/\.md$/, ''),
  data: c.data,
}));
---

<AppLayout
  title="Batam Car Rental - Rates in SGD & MYR"
  description="Explore our complete car rental collection in Batam: Avanza, Innova, Hiace, and Alphard. Self-drive and chauffeur services with free pickup at ferry terminals."
  lang="en"
>
  <div class="mb-6">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold mb-2">
      <Car class="w-3.5 h-3.5" />
      <span>Lincah Rent Car Catalog</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-2">
      Available Rental Cars in <span class="city-name-dyn">Batam</span>
    </h1>
    <p id="catalog-desc-en" class="text-xs sm:text-sm text-slate-500 max-w-2xl leading-relaxed">
      All vehicles are fully air-conditioned, sanitised, and serviced regularly. Complimentary handover at Harbour Bay, Batam Centre Ferry Terminal, and Hang Nadim Airport.
    </p>
  </div>

  <PickupHubChips lang="en" />

  <HorizontalFilterChips lang="en" />

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 my-6">
    {sortedCars.map((car) => (
      <VehicleCard
        id={car.id}
        slug={car.id.replace(/\.md$/, '')}
        data={car.data}
        lang="en"
      />
    ))}
  </div>

  <!-- Booking Guarantees -->
  <div class="my-10 bg-white rounded-2xl p-6 border border-slate-200/90 shadow-xs">
    <div class="flex items-center gap-2 mb-3">
      <ShieldCheck class="w-5 h-5 text-emerald-600" />
      <h2 class="text-base font-extrabold text-slate-900">Why Singaporeans & Malaysians Choose Us</h2>
    </div>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-600">
      <li class="flex items-start gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mt-1.5 shrink-0"></span>
        <span><strong>Easy ID Verification:</strong> Send your passport & driving license via WhatsApp for instant clearance.</span>
      </li>
      <li class="flex items-start gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mt-1.5 shrink-0"></span>
        <span id="guarantee-pickup-en"><strong>Direct Terminal Handover:</strong> Meet our driver right at Harbour Bay or Batam Centre arrival hall.</span>
      </li>
      <li class="flex items-start gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mt-1.5 shrink-0"></span>
        <span><strong>Transparent IDR Rates:</strong> No hidden surcharges. Clear estimated conversions in SGD & MYR.</span>
      </li>
      <li class="flex items-start gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mt-1.5 shrink-0"></span>
        <span><strong>Emergency Backup:</strong> 24/7 road assistance and immediate vehicle replacement if needed.</span>
      </li>
    </ul>
  </div>

  <BottomSheetModal cars={sheetCars} lang="en" />

  <script is:inline>
    function syncEnCarPageTexts(city) {
      const isPalembang = city === 'palembang';
      const cityName = isPalembang ? 'Palembang' : 'Batam';

      document.querySelectorAll('.city-name-dyn').forEach((el) => {
        el.textContent = cityName;
      });

      const descEl = document.getElementById('catalog-desc-en');
      if (descEl) {
        descEl.textContent = isPalembang
          ? 'All vehicles are fully air-conditioned, sanitised, and serviced regularly. Free handover at Sultan Mahmud Badaruddin II (SMB II) Airport, Kertapati Station, and central hotels.'
          : 'All vehicles are fully air-conditioned, sanitised, and serviced regularly. Complimentary handover at Harbour Bay, Batam Centre Ferry Terminal, and Hang Nadim Airport.';
      }

      const pickupEl = document.getElementById('guarantee-pickup-en');
      if (pickupEl) {
        pickupEl.innerHTML = isPalembang
          ? '<strong>Direct Arrival Handover:</strong> Meet our team directly at SMB II Airport arrival hall or Kertapati Station.'
          : '<strong>Direct Terminal Handover:</strong> Meet our driver right at Harbour Bay or Batam Centre arrival hall.';
      }

      document.querySelectorAll('.btn-wa-card').forEach((btn) => {
        const model = btn.getAttribute('data-car-model') || 'a vehicle';
        btn.href = `https://wa.me/6281373703639?text=${encodeURIComponent(`Hi Lincah Rent Car, I would like to book ${model} in ${cityName}. Could you check availability?`)}`;
      });
    }

    function initEnCarCitySync() {
      try {
        const savedCity = localStorage.getItem('lincah_city') || 'batam';
        syncEnCarPageTexts(savedCity);
      } catch (e) {}
    }

    window.addEventListener('cityChange', (e) => {
      if (e.detail && e.detail.city) {
        syncEnCarPageTexts(e.detail.city);
      }
    });

    document.addEventListener('DOMContentLoaded', initEnCarCitySync);
    document.addEventListener('astro:page-load', initEnCarCitySync);
  </script>
</AppLayout>
