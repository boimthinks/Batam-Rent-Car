---
import AppLayout from '../../layouts/AppLayout.astro';
import HorizontalFilterChips from '../../components/HorizontalFilterChips.astro';
import VehicleCard from '../../components/VehicleCard.astro';
import BottomSheetModal from '../../components/BottomSheetModal.astro';
import PickupHubChips from '../../components/PickupHubChips.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { getCollection } from 'astro:content';
import { Sparkles, ShieldCheck, Clock, CheckCircle2, ArrowRight, Car, MessageCircle } from '@lucide/astro';

const allCars = await getCollection('mobil');
const allLocations = await getCollection('lokasi');
const allServices = await getCollection('layanan');
const enBlogPostsRaw = await getCollection('blog', ({ data }) => data.lang === 'en');
const enBlogPosts = enBlogPostsRaw.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const sortedCars = [...allCars].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return 0;
});

const sheetCars = sortedCars.map((c) => ({
  id: c.id,
  slug: c.id.replace(/\.md$/, ''),
  data: c.data,
}));

const enServiceTitles: Record<string, { title: string; desc: string }> = {
  'lepas-kunci': {
    title: 'Self-Drive Car Rental',
    desc: 'Rent a car without a driver for ultimate privacy during your holiday or business trip. Easy WhatsApp verification.'
  },
  'dengan-supir': {
    title: 'Car Rental with Chauffeur',
    desc: 'Enjoy touring without driving fatigue. Accompanied by professional, courteous local drivers.'
  },
  'sewa-bulanan': {
    title: 'Monthly & Corporate Fleet Lease',
    desc: 'Cost-effective long-term car rental solutions for expatriates, multinational companies, and project contractors.'
  },
  'sewa-mingguan': {
    title: 'Weekly Car Rental (7-Day Discount)',
    desc: 'Cost-saving 7-day car rental package for extended holidays, family visits, or business projects.'
  },
  'antar-jemput-bandara-pelabuhan': {
    title: 'Airport & Ferry Terminal Transfer',
    desc: 'Punctual drop-off and pickup transfers from airports, ferry terminals, and railway stations.'
  }
};

const faqItemsEnBatam = [
  {
    question: "Can Singapore & Malaysia drivers legally rent a self-drive car in Batam?",
    answer: "Yes! Indonesia recognises Singapore Class 3 and Malaysian Class D driving licences as well as International Driving Permits. Driving is on the left side of the road (right-hand drive), just like in SG and MY."
  },
  {
    question: "How does the vehicle pickup at Harbour Bay or Batam Centre Ferry Terminal work?",
    answer: "Our representative will meet you directly at the ferry arrival hall with the vehicle ready and parked nearby. Key handover, identity verification, and brief condition check take less than 10 minutes."
  },
  {
    question: "What documents are required for booking?",
    answer: "A clear photo of your valid Passport, your Singapore or Malaysian Driving Licence, and your return ferry ticket confirmation. You can send these via WhatsApp for instant pre-arrival clearance."
  },
  {
    question: "Can I pay in SGD or credit card?",
    answer: "Our official pricing is in Indonesian Rupiah (IDR). We accept bank transfers, Wise, and cash IDR upon arrival. For your convenience, we display live estimated conversions in SGD and MYR."
  },
  {
    question: "Is chauffeur / private driver service available?",
    answer: "Yes! We offer professional with-driver packages if you prefer to sit back, relax, and explore Batam's seafood kelongs, shopping malls, and golf courses without navigating."
  }
];

const faqItemsEnPalembang = [
  {
    question: "How does car rental pickup at Sultan Mahmud Badaruddin II (SMB II) Airport work?",
    answer: "Our team will meet you at the domestic arrival gate of SMB II Airport. Your reserved vehicle will be parked at the airport parking area, cleaned and air-conditioned, ready for key handover."
  },
  {
    question: "Are self-drive car rentals available in Palembang for international tourists?",
    answer: "Yes! International visitors and travelers from Singapore or Malaysia can rent self-drive vehicles by providing a passport, valid driving licence (or IDP), and return flight or hotel booking."
  },
  {
    question: "Can I hire a car with driver for business trips across Palembang?",
    answer: "Yes, we provide professional chauffeurs who know Palembang city traffic, industrial routes, government offices along Jalan Sudirman, and the Jakabaring Sports Complex."
  },
  {
    question: "Is vehicle delivery available to Tanjung Api-Api Ferry Port?",
    answer: "Yes, we provide vehicle delivery directly to Tanjung Api-Api Port for travelers arriving on passenger ferries from Bangka Island (Muntok)."
  },
  {
    question: "How do I confirm a booking in Palembang?",
    answer: "Simply contact our WhatsApp customer support at +6281373703639 with your flight details or arrival time, and we will confirm your car reservation promptly."
  }
];
---

<AppLayout
  title="Batam Car Rental for Singapore & Malaysia Tourists"
  description="Affordable car hire in Batam from SGD 27/day. Self-drive & chauffeur service with free pickup at Harbour Bay & Batam Centre Ferry Terminals."
  lang="en"
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-700 via-blue-600 to-indigo-800 text-white rounded-3xl p-5 sm:p-8 mb-6 shadow-md relative overflow-hidden">
    <div class="absolute -right-10 -bottom-10 w-60 h-60 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>

    <div class="relative z-10 max-w-2xl">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-blue-100 text-xs font-bold mb-3 border border-white/20">
        <Sparkles class="w-3.5 h-3.5 text-amber-300" />
        <span id="hero-badge-city-en">SG & MY Visitors Special — Direct Arrival Pickup</span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-tight mb-2 sm:mb-3">
        <span class="city-name-dyn">Batam</span> Car Rental: Fast & Comfortable
      </h1>

      <p class="text-xs sm:text-sm text-blue-100/90 leading-relaxed mb-5" id="hero-desc-en">
        Rent a car in Batam from ~SGD 27 / ~MYR 85 per day. Free vehicle handover at Harbour Bay, Batam Centre Ferry Terminal, and Hang Nadim Airport.
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <a
          id="hero-wa-btn-en"
          href="https://wa.me/6281373703639?text=Hi%20Lincah%20Rent%20Car,%20I%20would%20like%20to%20book%20a%20car%20in%20Batam.%20Could%20you%20check%20availability%3F"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white text-xs sm:text-sm font-black shadow-md transition-all active:scale-95"
        >
          <MessageCircle class="w-4 h-4 fill-current" />
          <span>Book via WhatsApp</span>
        </a>

        <a
          href="/en/car/"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-white/15 hover:bg-white/25 text-white text-xs sm:text-sm font-bold backdrop-blur-sm border border-white/20 transition-colors"
        >
          <Car class="w-4 h-4" />
          <span>View All Cars</span>
        </a>
      </div>

      <div class="grid grid-cols-3 gap-2 mt-6 pt-5 border-t border-white/15 text-[11px] text-blue-100">
        <div class="flex items-center gap-1.5">
          <CheckCircle2 class="w-4 h-4 text-emerald-300 shrink-0" />
          <span>Self-Drive or Driver</span>
        </div>
        <div class="flex items-center gap-1.5">
          <ShieldCheck class="w-4 h-4 text-amber-300 shrink-0" />
          <span>Clean & Disinfected</span>
        </div>
        <div class="flex items-center gap-1.5">
          <Clock class="w-4 h-4 text-sky-300 shrink-0" />
          <span id="hero-trust-pickup-en">Ferry Standby 24/7</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Pickup Hubs (Batam & Palembang dynamic chips) -->
  <PickupHubChips lang="en" />

  <!-- Horizontal Filter Chips (App-like Category Filtering) -->
  <div class="flex items-center justify-between mt-6 mb-1">
    <div>
      <h2 class="text-sm sm:text-base font-black text-slate-900 uppercase tracking-wider">
        Our Car Selection
      </h2>
      <p class="text-xs text-slate-500">Filter vehicles by category, capacity, and rental type in <span class="city-name-dyn">Batam</span></p>
    </div>
  </div>

  <HorizontalFilterChips lang="en" />

  <!-- Vehicle Cards Grid -->
  <div id="fleet-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-10">
    {sortedCars.map((car) => (
      <VehicleCard
        id={car.id}
        slug={car.id.replace(/\.md$/, '')}
        data={car.data}
        lang="en"
      />
    ))}
  </div>

  <!-- Section Layanan Utama (Our Core Services) -->
  <section class="my-10 bg-white rounded-3xl p-6 border border-slate-200/90 shadow-xs">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-base sm:text-lg font-black text-slate-900">Our Core Rental Services</h2>
        <p class="text-xs text-slate-500">Comprehensive transportation solutions for holidays, business trips, and tours in <span class="city-name-dyn">Batam</span></p>
      </div>
      <a href="/en/layanan/" class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1">
        <span>All Services</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {allServices.map((srv) => {
        const slug = srv.id.replace(/\.md$/, '');
        const trans = enServiceTitles[slug] || { title: srv.data.title, desc: srv.data.shortDescEn || srv.data.shortDesc };
        const badgeEn = srv.data.badgeEn || srv.data.badge || 'Service';
        const isFeatured = slug === 'antar-jemput-bandara-pelabuhan';
        return (
          <a
            href={`/en/layanan/${slug}/`}
            class:list={[
              "rounded-2xl bg-slate-50 hover:bg-white border border-slate-200/80 hover:border-blue-300 hover:shadow-md transition-all group flex flex-col justify-between overflow-hidden",
              isFeatured && "sm:col-span-2 lg:col-span-2 lg:row-span-2"
            ]}
          >
            <div>
              <div class="relative aspect-[4/3] w-full bg-slate-100 overflow-hidden">
                <img
                  src={srv.data.image}
                  alt={trans.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md bg-white/90 backdrop-blur-xs text-slate-800 text-[10px] font-bold shadow-xs">
                  {badgeEn}
                </span>
              </div>
              <div class="p-4">
                <h3 class="font-extrabold text-sm text-slate-900 group-hover:text-blue-600 transition-colors mb-1.5">
                  {trans.title}
                </h3>
                <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                  {trans.desc}
                </p>
              </div>
            </div>
            <div class="p-4 pt-0 flex items-center gap-1 text-xs font-bold text-blue-600">
              <span>View Details</span>
              <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Travel Guides -->
  {enBlogPosts.length > 0 && (
    <section class="my-10">
      <div class="flex items-center justify-between mb-5">
        <div>
          <h2 class="text-base sm:text-lg font-black text-slate-900">
            Travel & Driving Guides <span class="city-name-dyn">Batam</span>
          </h2>
          <p class="text-xs text-slate-500" id="blog-section-subtitle-en">
            Requirements, route information, and vehicle handover advice in Batam
          </p>
        </div>
        <a href="/en/guide/" class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1">
          <span>All Guides</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4" id="home-en-blog-grid">
        {enBlogPosts.map((post) => {
          const slug = post.id.replace(/\.md$/, '');
          const postCity = post.data.city || 'Batam';
          const isDefaultBatam = postCity.toLowerCase() === 'batam';
          return (
            <article
              class:list={[
                "en-blog-article-card bg-white rounded-2xl border border-slate-200/90 shadow-xs overflow-hidden flex flex-col group hover:shadow-md transition-all",
                !isDefaultBatam && "hidden"
              ]}
              data-article-city={postCity}
            >
              <a href={`/en/guide/${slug}/`} class="aspect-[4/3] w-full overflow-hidden bg-slate-100 block">
                <img
                  src={post.data.featuredImage}
                  alt={post.data.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </a>
              <div class="p-4 flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-1">
                    <span class="text-[10px] font-bold text-slate-400">
                      {post.data.pubDate.toLocaleDateString('en-SG', { year: 'numeric', month: 'short', day: 'numeric' })}
                    </span>
                    <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-100">
                      {postCity}
                    </span>
                  </div>
                  <h3 class="font-extrabold text-xs sm:text-sm text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 mb-2 leading-snug">
                    <a href={`/en/guide/${slug}/`}>{post.data.title}</a>
                  </h3>
                  <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                    {post.data.summary}
                  </p>
                </div>
                <a href={`/en/guide/${slug}/`} class="mt-3 text-xs font-bold text-blue-600 hover:underline inline-flex items-center gap-1">
                  <span>Read Guide</span>
                  <ArrowRight class="w-3 h-3" />
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )}

  <!-- FAQ Accordion Batam (EN) -->
  <div id="faq-section-en-batam">
    <FaqAccordion
      items={faqItemsEnBatam}
      title="Frequently Asked Questions (Batam)"
      lang="en"
    />
  </div>

  <!-- FAQ Accordion Palembang (EN) -->
  <div id="faq-section-en-palembang" class="hidden">
    <FaqAccordion
      items={faqItemsEnPalembang}
      title="Frequently Asked Questions (Palembang)"
      lang="en"
    />
  </div>

  <!-- Bottom Sheet Modal -->
  <BottomSheetModal cars={sheetCars} lang="en" />

  <script is:inline>
    function syncEnHomePageTexts(city) {
      const isPalembang = city === 'palembang';
      const cityName = isPalembang ? 'Palembang' : 'Batam';

      // Update all .city-name-dyn
      document.querySelectorAll('.city-name-dyn').forEach((el) => {
        el.textContent = cityName;
      });

      // Update hero badge
      const heroBadge = document.getElementById('hero-badge-city-en');
      if (heroBadge) {
        heroBadge.textContent = isPalembang
          ? 'Fast & Reliable Palembang Car Rental'
          : 'SG & MY Visitors Special — Direct Arrival Pickup';
      }

      // Update hero description
      const heroDesc = document.getElementById('hero-desc-en');
      if (heroDesc) {
        heroDesc.textContent = isPalembang
          ? 'Rent a car in Palembang. Free vehicle handover at Sultan Mahmud Badaruddin II (SMB II) Airport, Kertapati Station, and central city hotels.'
          : 'Rent a car in Batam from ~SGD 27 / ~MYR 85 per day. Free vehicle handover at Harbour Bay, Batam Centre Ferry Terminal, and Hang Nadim Airport.';
      }

      // Update hero WA button
      const heroWa = document.getElementById('hero-wa-btn-en');
      if (heroWa) {
        const text = isPalembang
          ? 'Hi Lincah Rent Car, I would like to book a car in Palembang. Could you check availability?'
          : 'Hi Lincah Rent Car, I would like to book a car in Batam. Could you check availability?';
        heroWa.href = `https://wa.me/6281373703639?text=${encodeURIComponent(text)}`;
      }

      // Update trust badge
      const heroPickup = document.getElementById('hero-trust-pickup-en');
      if (heroPickup) {
        heroPickup.textContent = isPalembang ? 'Airport & Station Pickup' : 'Ferry Standby 24/7';
      }

      // Update blog subtitle
      const blogSub = document.getElementById('blog-section-subtitle-en');
      if (blogSub) {
        blogSub.textContent = isPalembang
          ? 'Requirements, route tips, and vehicle handover advice in Palembang'
          : 'Requirements, route information, and vehicle handover advice in Batam';
      }

      // Filter travel guides based on city
      const articleCards = document.querySelectorAll('.en-blog-article-card');
      articleCards.forEach((card) => {
        const cardCity = (card.getAttribute('data-article-city') || 'Batam').toLowerCase();
        if (cardCity === city.toLowerCase()) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      // Toggle FAQ sections
      const faqBatam = document.getElementById('faq-section-en-batam');
      const faqPalembang = document.getElementById('faq-section-en-palembang');
      if (faqBatam && faqPalembang) {
        if (isPalembang) {
          faqBatam.classList.add('hidden');
          faqPalembang.classList.remove('hidden');
        } else {
          faqPalembang.classList.add('hidden');
          faqBatam.classList.remove('hidden');
        }
      }
    }

    function initEnCitySync() {
      try {
        const savedCity = localStorage.getItem('lincah_city') || 'batam';
        syncEnHomePageTexts(savedCity);
      } catch (e) {}
    }

    window.addEventListener('cityChange', (e) => {
      if (e.detail && e.detail.city) {
        syncEnHomePageTexts(e.detail.city);
      }
    });

    document.addEventListener('DOMContentLoaded', initEnCitySync);
    document.addEventListener('astro:page-load', initEnCitySync);
  </script>
</AppLayout>
