---
import AppLayout from '../../../layouts/AppLayout.astro';
import VehicleCard from '../../../components/VehicleCard.astro';
import BottomSheetModal from '../../../components/BottomSheetModal.astro';
import AutoLinkContent from '../../../components/AutoLinkContent.astro';
import { renderMarkdownToString } from '../../../utils/renderMarkdown';
import { getCollection, render } from 'astro:content';
import { CheckCircle2, MessageCircle, ArrowLeft, ShieldCheck, Flame, ArrowRight } from '@lucide/astro';

export async function getStaticPaths() {
  const services = await getCollection('layanan');
  return services.map((srv) => ({
    params: { slug: srv.id.replace(/\.md$/, '') },
    props: { srv },
  }));
}

const { srv } = Astro.props;
const { Content } = await render(srv);
const d = srv.data;

// Get most popular cars (featured: true)
const allCars = await getCollection('mobil');
const popularCars = allCars.filter((car) => car.data.featured);

const sheetCars = popularCars.map((c) => ({
  id: c.id,
  slug: c.id.replace(/\.md$/, ''),
  data: c.data,
}));

const enServiceTitles: Record<string, { title: string; desc: string }> = {
  'lepas-kunci': {
    title: 'Self-Drive Car Rental in Batam - 24 Hours Flexibility',
    desc: 'Rent a car without a driver for ultimate privacy during your holiday or business trip in Batam. Easy online verification via WhatsApp with Singapore/Malaysia driving licence.'
  },
  'dengan-supir': {
    title: 'Car Rental with Chauffeur in Batam - Relax & Safe',
    desc: 'Enjoy touring Batam without driving fatigue. Accompanied by professional, courteous local drivers who know the best shortcut routes, seafood kelongs, and tourist spots.'
  },
  'sewa-bulanan': {
    title: 'Monthly & Corporate Fleet Rental Batam',
    desc: 'Cost-effective long-term car rental solutions for expatriates, multinational companies, and shipyard/offshore project contractors in Batam.'
  },
  'sewa-mingguan': {
    title: 'Weekly Car Rental in Batam - 7-Day Discount Package',
    desc: 'Cost-saving 7-day car rental package for extended holidays, family visits, or business projects in Batam. Self-drive or with professional chauffeur.'
  },
  'antar-jemput-bandara-pelabuhan': {
    title: 'Airport & Ferry Terminal Transfer Service',
    desc: 'Punctual drop-off and pickup transfers from Hang Nadim Airport and Ferry Terminals at Harbour Bay, Batam Centre, Sekupang, and Nongsapura.'
  }
};

const slug = srv.id.replace(/\.md$/, '');
const trans = enServiceTitles[slug] || { title: d.title, desc: d.shortDescEn || d.shortDesc };

// English content (falls back to Indonesian when EN field is empty)
const badgeEn = d.badgeEn || d.badge || 'Service';
const featuresEn = d.featuresEn || d.features;
const bodyEnHtml = d.bodyEn ? await renderMarkdownToString(d.bodyEn) : '';

const waText = `Hi Lincah Rent Car, I would like to inquire about ${trans.title} in Batam.`;
const waUrl = `https://wa.me/6281373703639?text=${encodeURIComponent(waText)}`;
---

<AppLayout
  title={trans.title}
  description={trans.desc}
  lang="en"
>
  <div class="mb-4">
    <a href="/en/layanan" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-blue-600">
      <ArrowLeft class="w-4 h-4" />
      <span>Back to Services</span>
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <!-- 4:3 Image -->
      <div class="relative aspect-[4/3] rounded-3xl overflow-hidden bg-slate-100 border border-slate-200/90 shadow-sm">
        <img
          src={d.image}
          alt={trans.title}
          class="w-full h-full object-cover"
        />
        <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-white/90 backdrop-blur-md text-slate-800 text-xs font-bold shadow-xs">
          {badgeEn}
        </span>
      </div>

      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-xs">
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 mb-3 tracking-tight">
          {trans.title}
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
          {trans.desc}
        </p>

        <div class="prose prose-slate max-w-none text-xs sm:text-sm leading-relaxed text-slate-700">
          {bodyEnHtml ? <AutoLinkContent lang="en" html={bodyEnHtml} /> : <Content />}
        </div>
      </div>

      <!-- Feature highlight -->
      <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-xs">
        <h2 class="text-base font-black text-slate-900 mb-3">Service Benefits</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {featuresEn.map((f) => (
            <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-700">
              <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0" />
              <span>{f}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Top Choice Vehicles for this service -->
      <div class="space-y-4 pt-4">
        <div class="flex items-center justify-between">
          <div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-[11px] font-bold mb-1">
              <Flame class="w-3.5 h-3.5 text-amber-600" />
              <span>Most Popular & Top Choice</span>
            </span>
            <h2 class="text-lg font-black text-slate-900">Recommended Vehicles</h2>
          </div>
          <a href="/en/car" class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1">
            <span>View All Cars</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {popularCars.map((car) => (
            <VehicleCard
              id={car.id}
              slug={car.id.replace(/\.md$/, '')}
              data={car.data}
              lang="en"
            />
          ))}
        </div>
      </div>
    </div>

    <!-- Right Sidebar CTA -->
    <div class="lg:col-span-1 space-y-4">
      <div class="bg-white rounded-3xl p-5 border border-slate-200/90 shadow-sm sticky top-20">
        <h3 class="text-base font-black text-slate-900 mb-2">Book This Service</h3>
        <p class="text-xs text-slate-500 mb-4 leading-relaxed">
          Contact our English-speaking WhatsApp team to arrange your schedule, special requirements, or custom fleet needs.
        </p>

        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-xs sm:text-sm shadow-md transition-all active:scale-95"
        >
          <MessageCircle class="w-4 h-4 fill-current" />
          <span>Inquire via WhatsApp</span>
        </a>

        <div class="mt-4 pt-4 border-t border-slate-100 flex items-start gap-2 text-xs text-slate-500">
          <ShieldCheck class="w-4 h-4 text-blue-600 shrink-0 mt-0.5" />
          <span>Quick response, available 24/7 every day.</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Sheet Modal for Quick Peek Specs -->
  <BottomSheetModal cars={sheetCars} lang="en" />
</AppLayout>
