---
import AppLayout from '../layouts/AppLayout.astro';
import HorizontalFilterChips from '../components/HorizontalFilterChips.astro';
import VehicleCard from '../components/VehicleCard.astro';
import BottomSheetModal from '../components/BottomSheetModal.astro';
import PickupHubChips from '../components/PickupHubChips.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { getCollection } from 'astro:content';
import { Sparkles, ShieldCheck, Clock, CheckCircle2, ArrowRight, Car, MessageCircle } from '@lucide/astro';

const allCars = await getCollection('mobil');
const allLocations = await getCollection('lokasi');
const allServices = await getCollection('layanan');
const blogPosts = await getCollection('blog', ({ data }) => data.lang === 'id');

// Sort cars so featured ones are first
const sortedCars = [...allCars].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return 0;
});

// Prepare data for BottomSheetModal
const sheetCars = sortedCars.map((c) => ({
  id: c.id,
  slug: c.id.replace(/\.md$/, ''),
  data: c.data,
}));

const faqItemsBatam = [
  {
    question: "Apa saja syarat sewa mobil lepas kunci di Batam?",
    answer: "Untuk wisatawan dari luar Batam, persyaratannya cukup mudah: foto KTP asli, foto SIM A aktif, tiket transportasi PP (pesawat/ferry), dan bukti reservasi hotel. Verifikasi dokumen dilakukan secara online via WhatsApp dalam waktu kurang dari 15 menit."
  },
  {
    question: "Apakah bisa antar-jemput mobil di Bandara Hang Nadim atau Pelabuhan Batam Centre?",
    answer: "Bisa! Kami menyediakan fasilitas serah terima unit gratis di Bandara Internasional Hang Nadim, Batam Centre Ferry Terminal, Harbour Bay Ferry Terminal, dan area Mega Legenda Batam."
  },
  {
    question: "Apakah wisman dari Singapura atau Malaysia bisa menyewa mobil lepas kunci?",
    answer: "Bisa. Wisatawan asal Singapura dan Malaysia dapat menyewa mobil lepas kunci dengan menunjukkan Paspor, Surat Izin Mengemudi yang sah (Driving Licence Singapore/Malaysia), serta tiket kapal ferry kepulangan."
  },
  {
    question: "Berapa jam hitungan sewa harian di Lincah Rent Car Batam?",
    answer: "Sewa lepas kunci dihitung 24 jam penuh per hari sejak jam serah terima kunci. Sedangkan untuk paket sewa dengan supir, durasinya adalah 12 jam per hari kerja di area Pulau Batam."
  },
  {
    question: "Bagaimana sistem pembayaran dan booking rental mobil Batam?",
    answer: "Pemesanan dapat langsung dikonfirmasi melalui admin WhatsApp kami di 0813-7370-3639. Pembayaran dapat dilakukan via transfer bank atau pelunasan saat serah terima kunci di lokasi."
  }
];

const faqItemsPalembang = [
  {
    question: "Apa saja syarat sewa mobil lepas kunci di Palembang?",
    answer: "Syarat mudah untuk wisatawan maupun warga Palembang: foto KTP/e-KTP asli, SIM A yang masih berlaku, bukti tiket transportasi PP (pesawat/kereta/travel) atau booking hotel. Verifikasi data online via WhatsApp dalam 10-15 menit."
  },
  {
    question: "Apakah bisa antar-jemput mobil di Bandara SMB II atau Pelabuhan Tanjung Api-Api?",
    answer: "Sangat bisa! Kami melayani pengantaran armada langsung ke lobi kedatangan Bandara Internasional Sultan Mahmud Badaruddin II (SMB II), Stasiun Kereta Api Kertapati, lobi hotel, hingga Pelabuhan Tanjung Api-Api untuk tamu penyeberangan dari Pulau Bangka."
  },
  {
    question: "Apakah tersedia paket rental mobil dengan supir di Palembang?",
    answer: "Ya, kami menyediakan layanan rental mobil dengan driver lokal berpengalaman yang menguasai jalanan Kota Palembang, rute kuliner pempek, kawasan bisnis Sudirman, Jakabaring, hingga area industri di Sumatera Selatan."
  },
  {
    question: "Berapa jam durasi sewa harian mobil di Palembang?",
    answer: "Untuk paket sewa lepas kunci dihitung 24 jam penuh per hari. Untuk paket dengan supir, durasi standar operasional adalah 12 jam per hari kerja."
  },
  {
    question: "Bagaimana cara booking mobil rental di Palembang?",
    answer: "Hubungi WhatsApp admin Lincah Rent Car di 0813-7370-3639. Tentukan pilihan mobil, tanggal sewa, dan titik penjemputan (Bandara SMB II, Stasiun, atau Hotel)."
  }
];
---

<AppLayout
  title="Rental Mobil Batam Murah Lepas Kunci & Driver"
  description="Sewa mobil Batam cepat dan terpercaya. Unit Avanza, Innova Reborn, Hiace, Alphard. Gratis antar-jemput di Bandara Hang Nadim, Batam Centre & Harbour Bay."
>
  <!-- Hero Section (Mobile App Banner Style) -->
  <section class="bg-gradient-to-br from-blue-700 via-blue-600 to-indigo-800 text-white rounded-3xl p-5 sm:p-8 mb-6 shadow-md relative overflow-hidden">
    <!-- Decorative background circle -->
    <div class="absolute -right-10 -bottom-10 w-60 h-60 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
    <div class="absolute right-10 top-0 w-32 h-32 rounded-full bg-blue-400/20 blur-xl pointer-events-none"></div>

    <div class="relative z-10 max-w-2xl">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-blue-100 text-xs font-bold mb-3 border border-white/20">
        <Sparkles class="w-3.5 h-3.5 text-amber-300" />
        <span id="hero-badge-city">Sewa Mobil Batam Cepat & Terpercaya</span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-tight mb-2 sm:mb-3">
        Sewa Mobil <span class="city-name-dyn">Batam</span>: Cepat, Nyaman, & Fleksibel
      </h1>

      <p class="text-xs sm:text-sm text-blue-100/90 leading-relaxed mb-5" id="hero-desc">
        Lepas kunci 24 jam atau dengan supir profesional. Serah terima gratis langsung di lobi Harbour Bay, Batam Centre Ferry Terminal, dan Bandara Hang Nadim.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3">
        <a
          id="hero-wa-btn"
          href="https://wa.me/6281373703639?text=Halo%20Admin%20Lincah%20Rent%20Car,%20saya%20tertarik%20sewa%20mobil%20di%20Batam.%20Mohon%20info%20ketersediaan%20unit"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white text-xs sm:text-sm font-black shadow-md transition-all active:scale-95"
        >
          <MessageCircle class="w-4 h-4 fill-current" />
          <span>Pesan via WhatsApp</span>
        </a>

        <a
          href="/mobil/"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-white/15 hover:bg-white/25 text-white text-xs sm:text-sm font-bold backdrop-blur-sm border border-white/20 transition-colors"
        >
          <Car class="w-4 h-4" />
          <span>Lihat Semua Mobil</span>
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="grid grid-cols-3 gap-2 mt-6 pt-5 border-t border-white/15 text-[11px] text-blue-100">
        <div class="flex items-center gap-1.5">
          <CheckCircle2 class="w-4 h-4 text-emerald-300 shrink-0" />
          <span>Lepas Kunci 24 Jam</span>
        </div>
        <div class="flex items-center gap-1.5">
          <ShieldCheck class="w-4 h-4 text-amber-300 shrink-0" />
          <span>Unit Wangi & Terawat</span>
        </div>
        <div class="flex items-center gap-1.5">
          <Clock class="w-4 h-4 text-sky-300 shrink-0" />
          <span id="hero-trust-pickup">Antar Pelabuhan Cepat</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Titik Jemput Populer (Pelabuhan & Bandara) -->
  <PickupHubChips lang="id" />

  <!-- Horizontal Filter Chips (App-like Category Filtering) -->
  <div class="flex items-center justify-between mt-6 mb-1">
    <div>
      <h2 class="text-sm sm:text-base font-black text-slate-900 uppercase tracking-wider">
        Pilihan Unit Mobil
      </h2>
      <p class="text-xs text-slate-500">Pilih tipe kendaraan sesuai kebutuhan perjalanan Anda di <span class="city-name-dyn">Batam</span></p>
    </div>
  </div>

  <HorizontalFilterChips lang="id" />

  <!-- Vehicle Cards Grid -->
  <div id="fleet-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-10">
    {sortedCars.map((car) => (
      <VehicleCard
        id={car.id}
        slug={car.id.replace(/\.md$/, '')}
        data={car.data}
        lang="id"
      />
    ))}
  </div>

  <!-- Section Layanan Utama -->
  <section class="my-10 bg-white rounded-3xl p-6 border border-slate-200/90 shadow-xs">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-base sm:text-lg font-black text-slate-900">Layanan Unggulan Kami</h2>
        <p class="text-xs text-slate-500">Solusi transportasi lengkap untuk liburan, dinas, maupun bisnis di <span class="city-name-dyn">Batam</span></p>
      </div>
      <a href="/layanan/" class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1">
        <span>Semua Layanan</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {allServices.map((srv) => {
        const slug = srv.id.replace(/\.md$/, '');
        const isFeatured = slug === 'antar-jemput-bandara-pelabuhan';
        return (
          <a
            href={`/layanan/${slug}/`}
            class:list={[
              "rounded-2xl bg-slate-50 hover:bg-white border border-slate-200/80 hover:border-blue-300 hover:shadow-md transition-all group flex flex-col justify-between overflow-hidden",
              isFeatured && "sm:col-span-2 lg:col-span-2 lg:row-span-2"
            ]}
          >
            <div>
              <div class="relative aspect-[4/3] w-full bg-slate-100 overflow-hidden">
                <img
                  src={srv.data.image}
                  alt={srv.data.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md bg-white/90 backdrop-blur-xs text-slate-800 text-[10px] font-bold shadow-xs">
                  {srv.data.badge || 'Layanan'}
                </span>
              </div>
              <div class="p-4">
                <h3 class="font-extrabold text-sm text-slate-900 group-hover:text-blue-600 transition-colors mb-1.5">
                  {srv.data.title.split('-')[0].trim()}
                </h3>
                <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                  {srv.data.shortDesc}
                </p>
              </div>
            </div>
            <div class="p-4 pt-0 flex items-center gap-1 text-xs font-bold text-blue-600">
              <span>Pelajari Detail</span>
              <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Section Blog / Edukasi Wisata & Rute -->
  <section class="my-10">
    <div class="flex items-center justify-between mb-5">
      <div>
        <h2 class="text-base sm:text-lg font-black text-slate-900">
          Panduan & Tips Wisata <span class="city-name-dyn">Batam</span>
        </h2>
        <p class="text-xs text-slate-500" id="blog-section-subtitle">
          Informasi praktis pelabuhan, rute perjalanan, & syarat sewa mobil di Batam
        </p>
      </div>
      <a href="/blog/" class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1">
        <span>Lihat Semua Artikel</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4" id="home-blog-grid">
      {blogPosts.map((post) => {
        const slug = post.id.replace(/\.md$/, '');
        const postCity = post.data.city || 'Batam';
        const isDefaultBatam = postCity.toLowerCase() === 'batam';
        return (
          <article
            class:list={[
              "blog-article-card bg-white rounded-2xl border border-slate-200/90 shadow-xs overflow-hidden flex flex-col group hover:shadow-md transition-all",
              !isDefaultBatam && "hidden"
            ]}
            data-article-city={postCity}
          >
            <a href={`/blog/${slug}/`} class="aspect-[4/3] w-full overflow-hidden bg-slate-100 block">
              <img
                src={post.data.featuredImage}
                alt={post.data.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </a>
            <div class="p-4 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-1">
                  <span class="text-[10px] font-bold text-slate-400">
                    {post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </span>
                  <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-100">
                    {postCity}
                  </span>
                </div>
                <h3 class="font-extrabold text-xs sm:text-sm text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 mb-2 leading-snug">
                  <a href={`/blog/${slug}/`}>{post.data.title}</a>
                </h3>
                <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                  {post.data.summary}
                </p>
              </div>
              <a href={`/blog/${slug}/`} class="mt-3 text-xs font-bold text-blue-600 hover:underline inline-flex items-center gap-1">
                <span>Baca Selengkapnya</span>
                <ArrowRight class="w-3 h-3" />
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- FAQ Accordion Batam -->
  <div id="faq-section-batam">
    <FaqAccordion items={faqItemsBatam} title="Pertanyaan Umum Seputar Rental Mobil di Batam" lang="id" />
  </div>

  <!-- FAQ Accordion Palembang -->
  <div id="faq-section-palembang" class="hidden">
    <FaqAccordion items={faqItemsPalembang} title="Pertanyaan Umum Seputar Rental Mobil di Palembang" lang="id" />
  </div>

  <!-- Bottom Sheet Modal (Interactivity island) -->
  <BottomSheetModal cars={sheetCars} lang="id" />

  <script is:inline>
    function syncHomePageTexts(city) {
      const isPalembang = city === 'palembang';
      const cityName = isPalembang ? 'Palembang' : 'Batam';

      // Update all .city-name-dyn elements
      document.querySelectorAll('.city-name-dyn').forEach((el) => {
        el.textContent = cityName;
      });

      // Update hero badge
      const heroBadge = document.getElementById('hero-badge-city');
      if (heroBadge) {
        heroBadge.textContent = isPalembang
          ? 'Sewa Mobil Palembang Cepat & Terpercaya'
          : 'Sewa Mobil Batam Cepat & Terpercaya';
      }

      // Update hero description
      const heroDesc = document.getElementById('hero-desc');
      if (heroDesc) {
        heroDesc.textContent = isPalembang
          ? 'Lepas kunci 24 jam atau dengan supir profesional. Serah terima mobil langsung di lobi Bandara SMB II, Stasiun Kertapati, Pelabuhan Tanjung Api-Api, dan hotel seputaran Palembang.'
          : 'Lepas kunci 24 jam atau dengan supir profesional. Serah terima gratis langsung di lobi Harbour Bay, Batam Centre Ferry Terminal, dan Bandara Hang Nadim.';
      }

      // Update hero WhatsApp button URL
      const heroWa = document.getElementById('hero-wa-btn');
      if (heroWa) {
        const text = isPalembang
          ? 'Halo Admin Lincah Rent Car, saya tertarik sewa mobil di Palembang. Mohon info ketersediaan unit'
          : 'Halo Admin Lincah Rent Car, saya tertarik sewa mobil di Batam. Mohon info ketersediaan unit';
        heroWa.href = `https://wa.me/6281373703639?text=${encodeURIComponent(text)}`;
      }

      // Update hero trust badge
      const heroPickup = document.getElementById('hero-trust-pickup');
      if (heroPickup) {
        heroPickup.textContent = isPalembang ? 'Antar Bandara & Stasiun' : 'Antar Pelabuhan Cepat';
      }

      // Update blog section subtitle
      const blogSub = document.getElementById('blog-section-subtitle');
      if (blogSub) {
        blogSub.textContent = isPalembang
          ? 'Panduan rute Bandara SMB II, destinasi kuliner pempek, & tips sewa mobil di Palembang'
          : 'Informasi praktis pelabuhan, rute perjalanan, & syarat sewa mobil di Batam';
      }

      // Filter blog article cards based on city
      const articleCards = document.querySelectorAll('.blog-article-card');
      articleCards.forEach((card) => {
        const cardCity = (card.getAttribute('data-article-city') || 'Batam').toLowerCase();
        if (cardCity === city.toLowerCase()) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      // Toggle FAQ sections based on city
      const faqBatam = document.getElementById('faq-section-batam');
      const faqPalembang = document.getElementById('faq-section-palembang');
      if (faqBatam && faqPalembang) {
        if (isPalembang) {
          faqBatam.classList.add('hidden');
          faqPalembang.classList.remove('hidden');
        } else {
          faqPalembang.classList.add('hidden');
          faqBatam.classList.remove('hidden');
        }
      }
    }

    function initHomePageCitySync() {
      try {
        const savedCity = localStorage.getItem('lincah_city') || 'batam';
        syncHomePageTexts(savedCity);
      } catch (e) {}
    }

    window.addEventListener('cityChange', (e) => {
      if (e.detail && e.detail.city) {
        syncHomePageTexts(e.detail.city);
      }
    });

    document.addEventListener('DOMContentLoaded', initHomePageCitySync);
    document.addEventListener('astro:page-load', initHomePageCitySync);
  </script>
</AppLayout>
