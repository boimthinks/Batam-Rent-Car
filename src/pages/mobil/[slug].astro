---
import AppLayout from '../../layouts/AppLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatIDR, estimateSGD, estimateMYR } from '../../utils/currency';
import { buildWhatsAppUrl } from '../../utils/whatsapp';
import { Users, Briefcase, Cog, CheckCircle2, ShieldCheck, MapPin, MessageCircle, ArrowLeft, ArrowRight, Clock } from '@lucide/astro';

export async function getStaticPaths() {
  const cars = await getCollection('mobil');
  return cars.map((car) => ({
    params: { slug: car.id.replace(/\.md$/, '') },
    props: { car },
  }));
}

const { car } = Astro.props;
const { Content } = await render(car);
const slug = car.id.replace(/\.md$/, '');
const d = car.data;

const allLocations = await getCollection('lokasi');
const allServices = await getCollection('layanan');

const hasSelfDrive = Boolean(d.priceDailySelfDrive);
const minPrice = d.priceDailySelfDrive || d.priceDailyWithDriver;

const waUrl = buildWhatsAppUrl({
  carModel: d.carModel,
  lang: 'id',
});

// Product & Offer Schema.org
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": d.title,
  "image": `https://lincahrentcar.com${d.image}`,
  "description": `${d.carModel} rental di Batam. Kapasitas ${d.seats} kursi, ${d.luggageCapacity} koper. Lepas kunci & supir.`,
  "brand": {
    "@type": "Brand",
    "name": "Lincah Rent Car"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "IDR",
    "price": minPrice,
    "availability": "https://schema.org/InStock",
    "url": `https://lincahrentcar.com/mobil/${slug}/`,
    "seller": {
      "@type": "AutoRental",
      "name": "Lincah Rent Car"
    }
  }
};
---

<AppLayout
  title={d.title}
  description={`Sewa mobil ${d.carModel} di Batam. Harga mulai ${formatIDR(minPrice)}/hari. Lepas kunci 24 jam atau dengan supir. Gratis serah terima di pelabuhan & bandara.`}
  ogImage={`https://lincahrentcar.com${d.image}`}
  schema={productSchema}
>
  <!-- Back Button & Breadcrumbs -->
  <div class="mb-3 flex items-center justify-between">
    <a href="/mobil/" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-blue-600">
      <ArrowLeft class="w-4 h-4" />
      <span>Kembali ke Katalog Mobil</span>
    </a>
    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">{d.category}</span>
  </div>

  <!-- Main H1 Heading for SEO -->
  <div class="mb-5">
    <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
      Rental Mobil {d.carModel} Batam
    </h1>
    <p class="text-xs sm:text-sm text-slate-500 mt-1">
      {d.popularFor} • Lepas kunci 24 jam & dengan supir
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left Col: Image & Description (2 cols) -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Big Vehicle Image (4:3) -->
      <div class="relative aspect-[4/3] rounded-3xl overflow-hidden bg-slate-100 border border-slate-200/90 shadow-sm">
        <img
          src={d.image}
          alt={d.carModel}
          class="w-full h-full object-cover"
        />
        <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-white/90 backdrop-blur-md text-slate-800 text-xs font-bold shadow-xs">
          {d.category}
        </span>
      </div>

      <!-- Specs Pills Bar -->
      <div class="grid grid-cols-3 gap-3 bg-white p-4 rounded-2xl border border-slate-200/90 shadow-xs">
        <div class="flex flex-col items-center text-center">
          <Users class="w-5 h-5 text-blue-600 mb-1" />
          <span class="text-[11px] text-slate-400 font-medium">Kapasitas</span>
          <span class="text-xs sm:text-sm font-extrabold text-slate-800">{d.seats} Penumpang</span>
        </div>
        <div class="flex flex-col items-center text-center border-x border-slate-100">
          <Briefcase class="w-5 h-5 text-blue-600 mb-1" />
          <span class="text-[11px] text-slate-400 font-medium">Muatan Bagasi</span>
          <span class="text-xs sm:text-sm font-extrabold text-slate-800">{d.luggageCapacity} Koper Besar</span>
        </div>
        <div class="flex flex-col items-center text-center">
          <Cog class="w-5 h-5 text-blue-600 mb-1" />
          <span class="text-[11px] text-slate-400 font-medium">Transmisi</span>
          <span class="text-xs sm:text-sm font-extrabold text-slate-800">{d.transmission}</span>
        </div>
      </div>

      <!-- Overview Content from Markdown -->
      <div class="bg-white p-6 rounded-3xl border border-slate-200/90 shadow-xs">
        <h2 class="text-lg font-black text-slate-900 mb-4">Deskripsi & Performa Kendaraan</h2>
        <div class="prose prose-slate max-w-none text-xs sm:text-sm leading-relaxed text-slate-600">
          <Content />
        </div>
      </div>

      <!-- Key Features List -->
      <div class="bg-white p-6 rounded-3xl border border-slate-200/90 shadow-xs">
        <h3 class="text-base font-black text-slate-900 mb-3">Fasilitas & Kelengkapan Unit</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {d.features.map((ft) => (
            <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-700">
              <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0" />
              <span>{ft}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Cardview Layanan -->
      <div class="space-y-4 pt-4">
        <div class="flex items-center justify-between">
          <div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-[11px] font-bold mb-1">
              <ShieldCheck class="w-3.5 h-3.5 text-blue-600" />
              <span>Pilihan Layanan</span>
            </span>
            <h2 class="text-lg font-black text-slate-900">Layanan Tersedia untuk {d.carModel}</h2>
          </div>
          <a href="/layanan/" class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1">
            <span>Semua Layanan</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {allServices.map((srv) => {
            const srvSlug = srv.id.replace(/\.md$/, '');
            const srvData = srv.data;
            return (
              <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xs hover:border-blue-500 hover:shadow-md transition-all overflow-hidden flex flex-col justify-between group">
                <div>
                  <a href={`/layanan/${srvSlug}/`} class="relative aspect-[4/3] w-full bg-slate-100 overflow-hidden block">
                    <img
                      src={srvData.image}
                      alt={srvData.title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                    <span class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-white/90 backdrop-blur-xs text-slate-800 text-[10px] font-bold shadow-xs">
                      {srvData.badge || 'Layanan'}
                    </span>
                  </a>

                  <div class="p-3.5">
                    <h3 class="text-xs font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-1 line-clamp-1">
                      <a href={`/layanan/${srvSlug}/`}>{srvData.title}</a>
                    </h3>
                    <p class="text-[11px] text-slate-500 line-clamp-2 leading-relaxed">
                      {srvData.shortDesc}
                    </p>
                  </div>
                </div>

                <div class="p-3.5 pt-0">
                  <a
                    href={`/layanan/${srvSlug}/`}
                    class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-[11px] font-bold text-blue-600 group-hover:text-blue-700"
                  >
                    <span>Pelajari Detail</span>
                    <ArrowRight class="w-3 h-3 group-hover:translate-x-1 transition-transform" />
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Cardview Titik Jemput Mobil -->
      <div class="space-y-4 pt-4">
        <div class="flex items-center justify-between">
          <div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-[11px] font-bold mb-1">
              <MapPin class="w-3.5 h-3.5 text-blue-600" />
              <span>Antar-Jemput Gratis</span>
            </span>
            <h2 class="text-lg font-black text-slate-900">Titik Jemput di <span class="city-name-dyn">Batam</span></h2>
          </div>
          <a href="/lokasi/" class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1">
            <span>Semua Titik Jemput</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {allLocations.map((loc) => {
            const locSlug = loc.id.replace(/\.md$/, '');
            const locData = loc.data;
            const locCity = locData.city || 'Batam';
            const isDefaultBatam = locCity.toLowerCase() === 'batam';
            return (
              <div
                class:list={[
                  "pickup-hub-card bg-white rounded-2xl border border-slate-200/90 shadow-xs hover:border-blue-500 hover:shadow-md transition-all overflow-hidden flex flex-col justify-between group",
                  !isDefaultBatam && "hidden"
                ]}
                data-city={locCity}
              >
                <div>
                  <a href={`/lokasi/${locSlug}/`} class="relative aspect-[4/3] w-full bg-slate-100 overflow-hidden block">
                    <img
                      src={locData.image}
                      alt={locData.title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                    <span class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-white/90 backdrop-blur-xs text-slate-800 text-[10px] font-bold shadow-xs">
                      {locData.hubType}
                    </span>
                    <span class="absolute top-2 right-2 px-2 py-0.5 rounded-md bg-emerald-500 text-white text-[10px] font-bold shadow-xs flex items-center gap-1">
                      <Clock class="w-2.5 h-2.5" />
                      <span>{locData.pickupTimeEstimate}</span>
                    </span>
                  </a>

                  <div class="p-3.5">
                    <h3 class="text-xs font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-1 line-clamp-1">
                      <a href={`/lokasi/${locSlug}/`}>{locData.areaName}</a>
                    </h3>
                    <p class="text-[11px] text-slate-500 line-clamp-2 leading-relaxed">
                      {locData.description}
                    </p>
                  </div>
                </div>

                <div class="p-3.5 pt-0">
                  <a
                    href={`/lokasi/${locSlug}/`}
                    class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-[11px] font-bold text-blue-600 group-hover:text-blue-700"
                  >
                    <span>Rincian Serah Terima</span>
                    <ArrowRight class="w-3 h-3 group-hover:translate-x-1 transition-transform" />
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <!-- Right Col: Booking Card & Rate Options (Sticky) -->
    <div class="lg:col-span-1 space-y-4">
      <div class="bg-white rounded-3xl p-5 border border-slate-200/90 shadow-sm sticky top-20">
        <span class="text-xs font-bold text-blue-600 uppercase tracking-wider block mb-1">
          Tarif Sewa Harian
        </span>
        <span class="text-xl sm:text-2xl font-black text-slate-900 mb-4 block">
          {d.carModel}
        </span>

        <!-- Price Options -->
        <div class="space-y-3 mb-5">
          {hasSelfDrive && (
            <div class="p-3.5 rounded-2xl bg-blue-50/70 border border-blue-200">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-blue-900">Lepas Kunci (24 Jam)</span>
                <span class="text-[11px] font-bold text-blue-600">{estimateSGD(d.priceDailySelfDrive!)}</span>
              </div>
              <div class="mt-1 flex items-baseline gap-1">
                <span class="text-xl font-black text-blue-700">{formatIDR(d.priceDailySelfDrive!)}</span>
                <span class="text-xs text-slate-500">/hari</span>
              </div>
              <span class="text-[10px] text-slate-500 block mt-1">Privasi penuh, syarat KTP/Paspor & SIM</span>
            </div>
          )}

          <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-900">Dengan Supir (12 Jam)</span>
              <span class="text-[11px] font-bold text-slate-600">{estimateSGD(d.priceDailyWithDriver)}</span>
            </div>
            <div class="mt-1 flex items-baseline gap-1">
              <span class="text-xl font-black text-slate-900">{formatIDR(d.priceDailyWithDriver)}</span>
              <span class="text-xs text-slate-500">/hari</span>
            </div>
            <span class="text-[10px] text-slate-500 block mt-1">Termasuk jasa driver profesional & ramah</span>
          </div>
        </div>

        <!-- WhatsApp Direct CTA -->
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-sm shadow-md transition-all active:scale-95"
        >
          <MessageCircle class="w-5 h-5 fill-current" />
          <span>Booking Unit via WhatsApp</span>
        </a>

        <!-- Guarantee Note -->
        <div class="mt-4 p-3 rounded-xl bg-amber-50 border border-amber-200/80 text-[11px] text-amber-900 flex items-start gap-1.5">
          <ShieldCheck class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" />
          <span>Garansi unit bersih disinfektan dan wangi sebelum serah terima kunci.</span>
        </div>
      </div>
    </div>
  </div>
  <script is:inline>
    function syncMobilDetailCity(city) {
      const isPalembang = city === 'palembang';

      // Update H2 .city-name-dyn (Titik Jemput di ...)
      document.querySelectorAll('.city-name-dyn').forEach((el) => {
        el.textContent = isPalembang ? 'Palembang' : 'Batam';
      });

      // Filter pickup hub cards by city
      const cards = document.querySelectorAll('.pickup-hub-card');
      cards.forEach((card) => {
        const cardCity = (card.getAttribute('data-city') || 'Batam').toLowerCase();
        if (cardCity === city.toLowerCase()) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    function initMobilDetailCitySync() {
      try {
        const savedCity = localStorage.getItem('lincah_city') || 'batam';
        syncMobilDetailCity(savedCity);
      } catch (e) {}
    }

    window.addEventListener('cityChange', (e) => {
      if (e.detail && e.detail.city) {
        syncMobilDetailCity(e.detail.city);
      }
    });

    document.addEventListener('DOMContentLoaded', initMobilDetailCitySync);
    document.addEventListener('astro:page-load', initMobilDetailCitySync);
  </script>
</AppLayout>
